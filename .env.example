# SPEC-004 — configuration for the local container stack (compose.stack.yaml).
#
# Copy to .env and fill in. .env is git-ignored and must never be committed: it holds real
# OIDC client secrets once you add them.
#
#   cp .env.example .env && ./scripts/stack-up.sh
#
# This stack is a LOCAL TESTING TOOL. It binds to 127.0.0.1 only, and it is not a
# deployment artifact — see docs/specs/SPEC-004-env-config-and-container-stack.md.

# ── Database ──────────────────────────────────────────────────────────────────
# The stack's own database, separate from the one compose.yaml starts for native
# development. Local only, so the values are not secret — but POSTGRES_PASSWORD is left
# empty on purpose and has no default: compose.stack.yaml refuses to start without it, so
# you get one named error up front instead of a confusing failure deep in the startup.
POSTGRES_DB=storeit
POSTGRES_PASSWORD=
POSTGRES_USER=storeit

# ── Web ───────────────────────────────────────────────────────────────────────
# The one URL you open. Must match the redirect URIs registered with your OIDC
# providers, port included (EC-03).
STOREIT_WEB_PORT=8080

# ── Runtime ───────────────────────────────────────────────────────────────────
# Note: ASPNETCORE_ENVIRONMENT is intentionally NOT configurable here. The stack always
# runs Production, which keeps POST /auth/dev-login unmapped — that endpoint hands out a
# session with no credential. For a Development-mode run, use ./scripts/dev.sh.

# ── Sign-in (optional) ────────────────────────────────────────────────────────
# Leave empty and the stack still starts and serves the app; only signing in is
# unavailable, because a provider is registered only when ClientId and Authority are both
# set. Redirect URI to register with the provider — it must carry the STOREIT_WEB_PORT set
# above (the examples use its 8080 default) and the host you actually type in the address bar:
#   http://localhost:8080/auth/callback/google
#   http://localhost:8080/auth/callback/microsoft
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Google__Authority=https://accounts.google.com

# Microsoft needs an authority whose discovery document names a CONCRETE issuer.
#   personal Microsoft accounts → /consumers/v2.0          (prefilled below)
#   a work/school directory     → /<domain-or-tenant-guid>/v2.0, e.g. /kms-ag.ch/v2.0
# Do not use `common` or `organizations`: both publish the issuer as the literal
# https://login.microsoftonline.com/{tenantid}/v2.0, and nothing here resolves that
# placeholder, so token validation fails. The authority also has to agree with the app
# registration's supported account types, or sign-in fails at the provider.
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__Microsoft__Authority=https://login.microsoftonline.com/consumers/v2.0
