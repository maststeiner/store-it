# EditorConfig is binding for humans and agents alike (see docs/guidelines/coding-guidelines.md)
# TODO: add language-specific rules once the stack is chosen (see docs/SETUP.md)

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
