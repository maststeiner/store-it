#!/bin/bash
# commit-msg hook: enforces Conventional Commits (Angular style) — see CLAUDE.md.
# Activate once per clone:  git config core.hooksPath .githooks

msg_file="$1"
subject=$(head -n1 "$msg_file")

# Allow merges, reverts generated by git, and fixup/squash commits
case "$subject" in
    Merge\ * | Revert\ * | fixup!\ * | squash\ *) exit 0 ;;
esac

# Subject: imperative, lowercase start, ≤ 100 chars, no trailing period.
# Note: subject is a single line (head -n1); "." in ERE never matches newline.
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?(!)?: [a-z](.{0,98}[^.])?$'

if ! echo "$subject" | grep -qE "$pattern"; then
    echo "✗ Commit message does not follow Conventional Commits (CLAUDE.md):" >&2
    echo "    $subject" >&2
    echo "  Expected:  type(scope): subject" >&2
    echo "  Types:     feat fix docs style refactor perf test build ci chore revert" >&2
    echo "  Subject:   imperative, lowercase, no trailing period, ≤ 100 chars" >&2
    exit 1
fi

exit 0
