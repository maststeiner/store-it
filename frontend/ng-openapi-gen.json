{
  "$schema": "./node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "../backend/openapi/StoreIt.Api.json",
  "output": "src/app/api",
  "services": true,
  "promises": false,
  "enumStyle": "alias",
  "enumArray": true,
  "removeStaleFiles": true,
  "indexFile": true,
  "endOfLineStyle": "lf",
  "serviceSuffix": "Service"
}
