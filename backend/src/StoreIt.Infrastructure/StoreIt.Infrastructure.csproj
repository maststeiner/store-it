<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\StoreIt.Application\StoreIt.Application.csproj" />
        <ProjectReference Include="..\StoreIt.Domain\StoreIt.Domain.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <!-- Session durability: the data-protection key ring lives in the database so a
           recreated container (every release) keeps decrypting existing session and CSRF
           cookies instead of signing everyone out. -->
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
</Project>
