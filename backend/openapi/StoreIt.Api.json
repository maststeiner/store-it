  "components": {
    "schemas": {
      "ExpiryStatus": {
        "enum": [
          "Ok",
          "ExpiringSoon",
          "Expired"
        ],
        "type": "string"
      },
      "ItemRequest": {
        "required": [
          "name",
          "amount",
          "unit",
          "expiryDate",
          "productionDate"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "productionDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "ItemResponse": {
        "required": [
          "id",
          "name",
          "amount",
          "unit",
          "expiryDate",
          "productionDate",
          "expiryStatus"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "productionDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "expiryStatus": {
            "$ref": "#/components/schemas/ExpiryStatus"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StorageRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "StorageResponse": {
        "required": [
          "id",
          "name",
          "itemCount",
          "expiredCount",
          "expiringSoonCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          },
          "expiredCount": {
            "type": "integer",
            "format": "int32"
          },
          "expiringSoonCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Unit": {
        "enum": [
          "Piece",
          "Gram",
          "Kilogram",
          "Milliliter",
          "Liter",
          "Pack"
        ],
        "type": "string"
      },
      "UserProfileResponse": {
        "required": [
          "id",
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "description": "BFF session cookie (HttpOnly). Established by the OIDC login flow (GET /auth/login/{provider} → callback).",
        "name": ".AspNetCore.Cookies",
        "in": "cookie"
      }
    }
  },
  "tags": [
