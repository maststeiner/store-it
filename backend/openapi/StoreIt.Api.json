  "components": {
    "schemas": {
      "ItemRequest": {
        "required": [
          "name",
          "amount",
          "unit",
          "expiryDate",
          "productionDate"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "expiryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "productionDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "StorageRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Unit": {
        "enum": [
          "Piece",
          "Gram",
          "Kilogram",
          "Milliliter",
          "Liter",
          "Pack"
        ]
      }
    }
