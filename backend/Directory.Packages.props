<Project>
    <!-- Central Package Management: single source of truth for NuGet versions
       across every store-it project. Individual .csproj files reference packages
       WITHOUT a Version attribute. Enabling this also converged pre-existing
       version drift across the test projects (xunit, xunit.runner.visualstudio,
       Microsoft.NET.Test.Sdk, coverlet). -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Analyzers (all projects, via Directory.Build.props). Pinned to the version
           SonarCloud itself runs — see the comment there. -->
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    </ItemGroup>

    <ItemGroup>
        <!-- Runtime / src -->
        <PackageVersion
            Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"
            Version="10.0.12"
        />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
        <PackageVersion
            Include="Microsoft.Extensions.DependencyInjection.Abstractions"
            Version="10.0.12"
        />
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
        <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- Test tooling. xunit.v3 runs on Microsoft.Testing.Platform (MTP): no Microsoft.NET.Test.Sdk,
           no VSTest adapter, and coverage comes from coverlet.MTP (coverlet.msbuild/.collector are
           VSTest-only and do not work with the .NET 10 `dotnet test` MTP mode). -->
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageVersion Include="ReferencesRuler" Version="1.3.2" />
        <!-- Used only by an architecture-test fixture project -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    </ItemGroup>
</Project>
