<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- xunit.v3 builds an executable that runs natively on Microsoft.Testing.Platform;
             `dotnet test` is switched to MTP in global.json, Stryker uses its MTP runner. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- Structure tests, not behavior tests — no coverlet.MTP reference, so no coverage is collected here -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NetArchTest.Rules" />
        <PackageReference Include="ReferencesRuler" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StoreIt.Api\StoreIt.Api.csproj" />
        <ProjectReference Include="..\..\src\StoreIt.Application\StoreIt.Application.csproj" />
        <ProjectReference Include="..\..\src\StoreIt.Domain\StoreIt.Domain.csproj" />
        <ProjectReference Include="..\..\src\StoreIt.Infrastructure\StoreIt.Infrastructure.csproj" />
    </ItemGroup>
</Project>
